<Project>
  <Target Name="GeneratePluginInfo" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <PluginName>XmPlaylist</PluginName>
      <PluginAuthor>$(USERNAME)</PluginAuthor>
      <PluginRepositoryUrl>https://github.com/$(USERNAME)/sat-list</PluginRepositoryUrl>
      <PluginVersion>1.0.0</PluginVersion>
      <PluginBranch>main</PluginBranch>
      <PluginMinLidarrVersion>3.0.0.4855</PluginMinLidarrVersion>
      <PluginBuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</PluginBuildDate>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(IntermediateOutputPath)PluginInfo.cs"
      Lines="// Auto-generated by PluginInfo.targets
namespace XmPlaylist
{
    public static class PluginInfo
    {
        public const string Name = &quot;XmPlaylist&quot;;
        public const string Author = &quot;ksamples14&quot;;
        public const string RepoUrl = &quot;https://github.com/ksamples14/lidarr.plugin.xmplaylist&quot;;
        public const string Version = &quot;1.0.0&quot;;
        public const string Branch = &quot;main&quot;;
        public const string BuildDate = &quot;$(PluginBuildDate)&quot;;
        public const string MinimumLidarrVersion = &quot;3.0.0.4855&quot;;
    }
}"
      Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PluginInfo.cs" />
    </ItemGroup>
  </Target>
</Project>
