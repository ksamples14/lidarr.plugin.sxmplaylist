    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>XmPlaylist.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lidarr.Common">
      <HintPath>..\..\lib\Lidarr.Common.dll</HintPath>
    </Reference>
    <Reference Include="Lidarr.Core">
      <HintPath>..\..\lib\Lidarr.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="FluentValidation" Version="9.5.4" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <PackageReference Include="NLog" Version="5.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistParser.cs" Link="XmPlaylistParser.cs" />
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistImportSettings.cs" Link="XmPlaylistImportSettings.cs" />
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistRequestBuilder.cs" Link="XmPlaylistRequestBuilder.cs" />
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistStationBackfill.cs" Link="XmPlaylistStationBackfill.cs" />
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistHistoryStore.cs" Link="XmPlaylistHistoryStore.cs" />
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistAlbumResolver.cs" Link="XmPlaylistAlbumResolver.cs" />
    <Compile Include="..\..\src\XmPlaylist\ImportLists\XmPlaylistChannelDirectory.cs" Link="XmPlaylistChannelDirectory.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
